{
	"name": "gaslight-code-runner",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --no-node-snapshot --import tsx src/development/index.ts",
		"start": "node --no-node-snapshot dist/index.js",
		"build": "tsc",
		"lint": "npx eslint \"**/*.ts\"",
		"lint:fix": "npx eslint \"**/*.ts\" --fix",
		"spellcheck": "npx cspell .",
		"test": "node --env-file-if-exists=.env --no-node-snapshot --import tsx --test \"src/**/*.test.ts\"",
		"test:unit": "node --env-file-if-exists=.env --no-node-snapshot --import tsx --test \"src/**/*.unit.test.ts\"",
		"test:integration": "node --env-file-if-exists=.env --no-node-snapshot --import tsx --test \"src/**/*.integration.test.ts\""
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@logtail/node": "^0.5.8",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.8.0",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/instrumentation": "^0.219.0",
		"@opentelemetry/sdk-trace-base": "^2.8.0",
		"@sentry/cli": "^3.5.1",
		"@sentry/node": "^10.59.0",
		"@sentry/profiling-node": "^10.59.0",
		"axios": "^1.18.0",
		"config": "^4.4.1",
		"cors": "^2.8.6",
		"esbuild": "^0.28.1",
		"express": "^5.2.1",
		"helmet": "^8.2.0",
		"isolated-vm": "^7.0.0",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/config": "^4.4.0",
		"@types/cors": "^2.8.19",
		"@types/eslint": "^9.6.1",
		"@types/express": "^5.0.6",
		"@types/node": "^26.0.0",
		"cspell": "^10.0.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.2.1",
		"eslint-plugin-promise": "^7.3.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	}
}
