{
	"name": "gaslight-code-runner",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "node --no-node-snapshot \"index.js\"",
		"dev": "(if exist dist rmdir /s /q dist) & tsc && node --env-file .env \"dist/development/index.js\"",
		"test:unit": "mocha --reporter spec --recursive \"dist/test/unit/**/*.spec.js\"",
		"test:integration": "mocha --reporter spec --recursive \"dist/test/integration/**/*.spec.js\"",
		"test:development": "mocha --reporter spec --recursive \"dist/test/development/**/*.spec.js\"",
		"lint": "npx eslint \"**/*.ts\"",
		"lint:fix": "npx eslint \"**/*.ts\" --fix",
		"spellcheck": "npx cspell ."
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@logtail/node": "^0.5.8",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.8.0",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/instrumentation": "^0.219.0",
		"@opentelemetry/sdk-trace-base": "^2.8.0",
		"@sentry/cli": "^3.5.1",
		"@sentry/node": "^10.59.0",
		"@sentry/profiling-node": "^10.59.0",
		"axios": "^1.18.0",
		"config": "^4.4.1",
		"cors": "^2.8.6",
		"esbuild": "^0.28.1",
		"express": "^5.2.1",
		"helmet": "^8.2.0",
		"isolated-vm": "^7.0.0",
		"logform": "^2.7.0",
		"validator": "^13.15.35",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/chai": "^5.2.3",
		"@types/config": "^4.4.0",
		"@types/cors": "^2.8.19",
		"@types/eslint": "^9.6.1",
		"@types/express": "^5.0.6",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.0.0",
		"@types/sinon": "^21.0.1",
		"@types/validator": "^13.15.10",
		"@typescript-eslint/eslint-plugin": "^8.61.1",
		"chai": "^6.2.2",
		"chai-http": "^5.1.2",
		"cspell": "^10.0.1",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.1.0",
		"eslint-plugin-promise": "^7.3.0",
		"mocha": "^11.7.6",
		"nyc": "^18.0.0",
		"sinon": "^22.0.0",
		"source-map-support": "^0.5.21",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	}
}
